# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Featherless (document extraction, Phase 3) — set the key in .env, never commit it
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3.2

SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_TAG=proofly_demo_maya
TAVILY_API_KEY=

# Document-grounded chat retrieval (Phase 5) — reuses SUPERMEMORY_API_KEY / FEATHERLESS_API_KEY above
CHAT_RETRIEVAL_LIMIT=5
# CHAT_RELEVANCE_THRESHOLD=0.5   # uncomment to set a minimum similarity floor (0-1); unset = no floor
CHAT_MAX_CONTEXT_CHARACTERS=8000
